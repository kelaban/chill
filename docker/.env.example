# Copy to docker/.env (gitignored). Secrets stay on the server.

# TMDB "API Read Access Token" (themoviedb.org → Settings → API)
TMDB_TOKEN=
# chill.institute token (chill.institute/auth/chilly-token)
CHILL_TOKEN=
# put.io OAuth token (app.put.io/oauth → your app → key icon)
PUTIO_TOKEN=

# Folder chill owns on put.io
PUTIO_FOLDER=chill
# Budgets (GB)
PUTIO_BUDGET_GB=100
LOCAL_BUDGET_GB=100
# Start the runner-up release if the fast copy is under 50% after this many seconds
RACE_AFTER_S=90
# TV capabilities (Phase 0 measures these; see documentation/DECISIONS.md)
TV_TWO_DECODERS=1
TV_SWAP_LATENCY_MS=800
